{
  "schema": 1,
  "id": "mp4upload",
  "name": "Mp4Upload",
  "version": "1.0.0",
  "note": "anime-sdk / Migurdex uyarlaması — doğrudan video.mp4 çıkarıcı",
  "domains": ["mp4upload.com"],
  "steps": [
    {
      "op": "http_get",
      "url": "{{url}}",
      "headers": { "Referer": "https://mp4upload.com/" }
    },
    {
      "op": "js_unpack",
      "from": "body",
      "var": "unpacked",
      "optional": true
    },
    {
      "op": "emit_regex_all",
      "from": "body",
      "pattern": "src\\s*:\\s*[\"'](https?://[^\"']+/video\\.mp4(?:\\?[^\"']*)?)[\"']",
      "url_group": 1,
      "referer": "https://mp4upload.com/",
      "optional": true
    },
    {
      "op": "emit_regex_all",
      "from": "unpacked",
      "only_if": "unpacked",
      "pattern": "src\\s*:\\s*[\"'](https?://[^\"']+\\.mp4(?:\\?[^\"']*)?)[\"']",
      "url_group": 1,
      "referer": "https://mp4upload.com/",
      "optional": true
    }
  ]
}
